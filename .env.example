# Configuración de Variables de Entorno para Email

# Servicio de email
# Opciones: 'gmail' o 'smtp'
EMAIL_SERVICE=gmail

# Credenciales de Gmail
# Para Gmail, usar "Contraseña de aplicación" no la contraseña normal
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-app-de-16-caracteres

# Para otros servidores SMTP (si EMAIL_SERVICE no es 'gmail')
# EMAIL_HOST=smtp.tuservidor.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Email que aparecerá como remitente
EMAIL_FROM=noreply@bibliotecadigital.com

# URL base para el enlace de verificación
# Cambiar según el entorno (local, staging, producción)
VERIFICATION_URL=http://localhost:3000

# Otros parámetros (opcionales)
# Tiempo de expiración del token en horas (default: 24)
# TOKEN_EXPIRATION_HOURS=24
